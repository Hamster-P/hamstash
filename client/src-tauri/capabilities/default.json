{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:8080/*" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/mpv", "sidecar": true }]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}