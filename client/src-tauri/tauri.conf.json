{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HamStash",
  "version": "0.5.2",
  "identifier": "com.godpan.hamstash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HamStash · 囤番鼠",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mpv"],
    "resources": [
      "vulkan-1.dll",
      "backend/hamstash-server/**/*",
      "backend/nssm.exe"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi"
      }
    }
  }
}
